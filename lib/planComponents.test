const { planComponents } = require('/tmp/herb/lib/planComponents.js');

let pass=0, fail=0;
const ok=(c,m)=>{ if(c) pass++; else { fail++; console.log('   ✗ FAIL:', m); } };

// Real numbers: NM-062 'Cooked chicken, pulled', measured from the live book.
// Karum, 28 Aug 2026 (ESTIMATE — the weighing is still TO DO):
//   1.6kg bone-in bird @ £4.50  ->  ~1.2kg out of the oven (25% cooking loss)
//   ->  65% of THAT is pulled meat  =  780g
//   ->  yield on as-sold weight = 780/1600 = 48.75%,  cost = £5.77/kg edible
// 780g against 730g of demand is only 50g of headroom — one repeated dish
// tips the week onto a second bird, so the multi-cook path is load-bearing.
const CHICKEN = {
  id: 'comp-chicken', name: 'Pulled roast chicken',
  produces_ingredient_id: 'NM-062', yield_qty: 780, shelf_life_days: 5,
  inputs: [{ ingredient_id: 'NM-126', quantity: 1600 }],   // one 1.6kg bird
};
// A deliberately small component, kept so the SPLIT-across-two-cooks path stays
// covered now that one bird is big enough to never split on real data.
const SMALL = { ...CHICKEN, id:'comp-small', name:'Small batch prep', yield_qty: 200 };
const NEEDS = {  // the six real dishes and their real grams
  'asian':  [{ ingredient_id:'NM-062', quantity:150 }],
  'caesar': [{ ingredient_id:'NM-062', quantity:150 }],
  'harissa':[{ ingredient_id:'NM-062', quantity:150 }],
  'pesto':  [{ ingredient_id:'NM-062', quantity:120 }],
  'hammush':[{ ingredient_id:'NM-062', quantity:80  }],
  'prosc':  [{ ingredient_id:'NM-062', quantity:80  }],
  'madras': [],                                    // no component need
};
const slot=(d,meal,r)=>({slot_date:d,meal,recipe_id:r,source:'fresh_cook',portions:1});
const W='2026-08-31';  // Monday
const d=(n)=>['2026-08-31','2026-09-01','2026-09-02','2026-09-03','2026-09-04','2026-09-05','2026-09-06'][n];

// ── C1 · the core case: batch day Monday, four chicken dishes that week ──
console.log('\nC1 · one bird, four dishes, all inside shelf life');
const c1 = planComponents(
  [slot(d(0),'dinner','asian'), slot(d(1),'lunch','caesar'),
   slot(d(2),'dinner','harissa'), slot(d(3),'lunch','hammush'), slot(d(2),'lunch','madras')],
  NEEDS, [CHICKEN], [], { weekStart:W, batchDays:[d(0)] });
ok(c1.cooks.length===1, 'C1 exactly ONE prep cook scheduled, got '+c1.cooks.length);
ok(c1.cooks[0].cook_date===d(0), 'C1 cook lands on the batch day');
ok(c1.cooks[0].expiry_date==='2026-09-05', 'C1 expiry = cook + 5 days, got '+c1.cooks[0]?.expiry_date);
ok(c1.cooks[0].yield_qty===780, 'C1 one bird yields 780g');
ok(c1.shortfalls.length===0, 'C1 no shortfall (530g of 780g used)');
ok(c1.cooks[0].inputs[0].ingredient_id==='NM-126', 'C1 the cook carries its INPUT (a whole bird) for the shopping list');

// ── C2 · the 2-and-2 rule genuinely does not apply ──
console.log('C2 · a component is not slot-capped');
const c2 = planComponents(
  [slot(d(0),'lunch','asian'), slot(d(0),'dinner','caesar'), slot(d(1),'lunch','harissa'),
   slot(d(1),'dinner','pesto'), slot(d(2),'lunch','hammush'), slot(d(2),'dinner','prosc')],
  NEEDS, [CHICKEN], [], { weekStart:W, batchDays:[d(0)] });
const c2slots = new Set(c2.coverage.map(c=>c.date+'|'+c.meal));
ok(c2slots.size===6, 'C2 ALL SIX chicken dishes served — no slot cap exists to fire, got '+c2slots.size);
ok(c2.cooks.length===1, 'C2 one 780g bird still covers the whole 730g book (50g spare), got '+c2.cooks.length+' cook(s)');
ok(c2.shortfalls.length===0, 'C2 nothing short');

// ── C2b · a component too small for one use still splits across cooks ──
console.log('C2b · split across two cooks');
const c2b = planComponents([slot(d(0),'dinner','asian')], NEEDS, [SMALL], [],
  { weekStart:W, batchDays:[d(0)] });
ok(c2b.cooks.length===1, 'C2b 150g fits one 200g prep');
const c2c = planComponents([slot(d(0),'dinner','asian'), slot(d(0),'lunch','caesar')],
  NEEDS, [SMALL], [], { weekStart:W, batchDays:[d(0)] });
ok(c2c.cooks.length===2, 'C2c 300g needs two 200g preps on the same day, got '+c2c.cooks.length);
ok(c2c.coverage.some(c=>c.quantity===50), 'C2c the second dish SPLITS 50g/100g across the two preps');

// ── C3 · SHELF LIFE is what binds, not the cap ──
console.log('C3 · shelf life binds');
const c3 = planComponents(
  [slot(d(0),'dinner','asian'), slot(d(6),'dinner','caesar')],  // day 6 = 6 days later
  NEEDS, [CHICKEN], [], { weekStart:W, batchDays:[d(0)] });
ok(c3.shortfalls.length===1, 'C3 the day-6 dish is NOT covered by Monday bird');
ok(/shelf life/.test(c3.shortfalls[0]?.reason||''), 'C3 reason names shelf life, got: '+c3.shortfalls[0]?.reason);
ok(c3.rationale.some(r=>/short for dinner on 2026-09-06/.test(r)), 'C3 reported in plain words');

// ── C4 · a second batch day rescues it ──
console.log('C4 · second batch day covers the tail');
const c4 = planComponents(
  [slot(d(0),'dinner','asian'), slot(d(6),'dinner','caesar')],
  NEEDS, [CHICKEN], [], { weekStart:W, batchDays:[d(0), d(4)] });
ok(c4.cooks.length===2, 'C4 two cooks, got '+c4.cooks.length);
ok(c4.shortfalls.length===0, 'C4 nothing short');

// ── C5 · existing fridge stock is used FIRST (anti-waste) ──
console.log('C5 · anti-waste: stock before a new cook');
const c5 = planComponents(
  [slot(d(0),'dinner','asian')], NEEDS, [CHICKEN],
  [{ ingredient_id:'NM-062', quantity:200, expiry_date:'2026-09-02' }],
  { weekStart:W, batchDays:[d(0)] });
ok(c5.cooks.length===0, 'C5 no cook scheduled — the fridge already had enough');
ok(c5.coverage[0].from==='stock', 'C5 coverage says it came from stock');

// ── C6 · out-of-date stock is NOT used ──
console.log('C6 · expired stock ignored');
const c6 = planComponents(
  [slot(d(4),'dinner','asian')], NEEDS, [CHICKEN],
  [{ ingredient_id:'NM-062', quantity:200, expiry_date:'2026-09-01' }],
  { weekStart:W, batchDays:[d(4)] });
ok(c6.cooks.length===1, 'C6 stock expired before the meal, so a cook IS scheduled');

// ── C7 · no batch day at all ──
console.log('C7 · nowhere to cook it');
const c7 = planComponents([slot(d(2),'dinner','asian')], NEEDS, [CHICKEN], [],
  { weekStart:W, batchDays:[] });
ok(c7.cooks.length===0 && c7.shortfalls.length===1, 'C7 shortfall, no cook');
ok(/no batch day/.test(c7.shortfalls[0].reason), 'C7 reason names the missing batch day');

// ── C8 · guests scale the component demand ──
console.log('C8 · guests scale grams');
const g = {...slot(d(0),'dinner','asian'), portions:4};
const c8 = planComponents([g], NEEDS, [CHICKEN], [], { weekStart:W, batchDays:[d(0)] });
ok(c8.coverage.reduce((s,c)=>s+c.quantity,0)===600, 'C8 150g x 4 people = 600g covered, got '+c8.coverage.reduce((s,c)=>s+c.quantity,0));
ok(c8.cooks.length===1, 'C8 600g fits inside ONE 780g bird, got '+c8.cooks.length);
ok(c8.shortfalls.length===0, 'C8 nothing short once the second bird is allowed');

// ── C9 · dishes with no component need are untouched; out/empty slots ignored ──
console.log('C9 · irrelevant slots ignored');
const c9 = planComponents(
  [slot(d(0),'dinner','madras'),
   {slot_date:d(1),meal:'dinner',recipe_id:null,source:'out',portions:1},
   {slot_date:d(2),meal:'dinner',recipe_id:'asian',source:'empty',portions:1}],
  NEEDS, [CHICKEN], [], { weekStart:W, batchDays:[d(0)] });
ok(c9.cooks.length===0, 'C9 no cook — madras needs none, out/empty slots do not create demand');
ok(c9.shortfalls.length===0, 'C9 no phantom shortfall');

// ── C10 · generalises: a second component with different numbers ──
console.log('C10 · generalises beyond chicken');
const SAUCE = { id:'comp-sauce', name:'Pasta base sauce', produces_ingredient_id:'NM-900',
                yield_qty:800, shelf_life_days:4, inputs:[{ingredient_id:'NM-tomato',quantity:800}] };
const N2 = { ...NEEDS, pasta1:[{ingredient_id:'NM-900',quantity:300}],
                       pasta2:[{ingredient_id:'NM-900',quantity:300}],
                       both:[{ingredient_id:'NM-900',quantity:200},{ingredient_id:'NM-062',quantity:150}] };
const c10 = planComponents(
  [slot(d(0),'dinner','pasta1'), slot(d(1),'dinner','pasta2'), slot(d(2),'dinner','both')],
  N2, [CHICKEN, SAUCE], [], { weekStart:W, batchDays:[d(0)] });
ok(c10.cooks.length===2, 'C10 one sauce cook + one chicken cook, got '+c10.cooks.length);
ok(new Set(c10.cooks.map(c=>c.component_id)).size===2, 'C10 two DIFFERENT components scheduled');
ok(c10.cooks.find(c=>c.component_id==='comp-sauce').expiry_date==='2026-09-04',
   'C10 the sauce uses ITS OWN 4-day shelf life, not the chicken 5');

// ── C11 · the oven cap bites, and says so ──
console.log('C11 · oven cap');
const big = {...slot(d(0),'dinner','asian'), portions:20};   // 3000g > 2 birds (1560g)
const c11 = planComponents([big], NEEDS, [CHICKEN], [], { weekStart:W, batchDays:[d(0)], maxCooksPerDay:2 });
ok(c11.cooks.length===2, 'C11 capped at 2 cooks a day, got '+c11.cooks.length);
ok(c11.shortfalls.length===1 && /prep cook/.test(c11.shortfalls[0].reason), 'C11 shortfall names the oven cap, got: '+c11.shortfalls[0]?.reason);

// ── C12 · REAL headroom: a repeated dish tips the week onto a second bird ──
console.log('C12 · 50g of headroom');
const c12 = planComponents(
  [slot(d(0),'lunch','asian'), slot(d(0),'dinner','caesar'), slot(d(1),'lunch','harissa'),
   slot(d(1),'dinner','pesto'), slot(d(2),'lunch','hammush'), slot(d(2),'dinner','prosc'),
   slot(d(3),'lunch','asian')],                       // the 2-and-2 rule allows this repeat
  NEEDS, [CHICKEN], [], { weekStart:W, batchDays:[d(0)] });
ok(c12.cooks.length===2, 'C12 880g demand vs a 780g bird -> a SECOND bird, got '+c12.cooks.length);
ok(c12.shortfalls.length===0, 'C12 and it is covered, not reported short');

console.log(`\n${pass} passed, ${fail} failed`);
process.exit(fail?1:0);
